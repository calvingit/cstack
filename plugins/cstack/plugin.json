{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cstack",
  "version": "0.6.9",
  "description": "CStack 工程方法 Skills：覆盖需求澄清、方案设计、实现、验收、审查与交付。",
  "author": {
    "name": "calvingit"
  },
  "homepage": "https://github.com/calvingit/cstack",
  "repository": "https://github.com/calvingit/cstack",
  "keywords": [
    "skills",
    "engineering",
    "workflow",
    "verification",
    "code-review"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "CStack",
        "shortDescription": "面向 AI Coding Agent 的工程方法",
        "longDescription": "按需使用需求澄清、方案设计、实现、验收、审查和交付 Skills；包含六阶段地图、共享产物链和可派发的 Agent 角色。",
        "developerName": "calvingit",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/calvingit/cstack",
        "defaultPrompt": [
          "用 CStack 的工程方法推进当前任务",
          "审查这次变更并给出有证据的结论"
        ]
      }
    }
  }
}
